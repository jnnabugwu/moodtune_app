{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart"
      ]
    },
    {
      "name": "Launch development (iPhone, Railway backend)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "deviceId": "00008150-000C799E1490C01C",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--dart-define-from-file=dev.env",
        "--dart-define=API_BASE_URL=https://moodtune-backend-production-e4fe.up.railway.app/api/v1"
      ]
    },
    {
      "name": "Launch production (iPhone)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "deviceId": "00008150-000C799E1490C01C",
      "args": [
        "--flavor",
        "production",
        "--target",
        "lib/main_production.dart",
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": ["--flavor", "staging", "--target", "lib/main_staging.dart"]
    },
    {
      "name": "Launch production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": ["--flavor", "production", "--target", "lib/main_production.dart"]
    }
  ]
}
