SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend base URL (production)
API_BASE_URL=https://moodtune-backend-production-e4fe.up.railway.app/api/v1

# Optional: staging/local overrides
# API_BASE_URL=http://127.0.0.1:8000/api/v1


# Optional: Google Sign-In OAuth clients (Google Cloud console). The button
# stays hidden until they're set: iOS needs both, Android only the web one.
# GOOGLE_WEB_CLIENT_ID=1234-web.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=1234-ios.apps.googleusercontent.com

# Meta App ID for Instagram Stories sharing (#35), from developers.facebook.com
# → App settings → Basic. It's a public identifier, not a secret; never put
# the Meta App Secret here.
# META_APP_ID=1234567890123456
